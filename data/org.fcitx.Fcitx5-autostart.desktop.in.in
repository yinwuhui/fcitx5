[Desktop Entry]
Name=BubbleFish
Comment=Start BubbleFish Input Method
Exec=@FCITX_INSTALL_BINDIR@/fcitx5
Icon=bubblefish
Terminal=false
Type=Application
NoDisplay=true
StartupNotify=false
